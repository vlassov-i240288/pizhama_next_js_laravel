# Example frontend env for local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# Analytics / search engine verification (optional; leave empty to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Lead emails (server-side, read at runtime). Put real values in .env.production.local on the server
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=leads@pizhama.kz
